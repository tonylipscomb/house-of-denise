BOOKING_NOTIFICATION_EMAIL=info@houseofdenise.com
# Must use a verified Resend domain, e.g. House of Denise <bookings@houseofdenise.com>
# Until the domain is verified, Resend only allows: House of Denise <onboarding@resend.dev>
# and only delivers to your Resend account email.
BOOKING_FROM_EMAIL=
BOOKING_REPLY_TO_EMAIL=info@houseofdenise.com
